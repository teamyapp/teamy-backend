schema {
    query: Query
    mutation: Mutation
}

type Query {
    needAttention: Task
    upcoming: [Task!]!
    delivered: [Task!]!
}

type Mutation {
    createTask(task: TaskInput!): ID!
    deleteTask(taskId: ID!): Void
    updateTask(taskId: ID!, task: TaskInput!): Void
}

input TaskInput {
    goal: String
    dueAt: Date
    effort: Int
    context: String
    ownerUserID: ID
}

type Task {
    id: ID!
    goal: String
    dueAt: Date
    effort: Int
    context: String
    owner: User
    availableActions: [TaskAction]
}

type User {
    id: ID!
    name: String!
    profileUrl: String
}

enum TaskAction {
    START
    DELETE
    ASSIGN_OWNER
    REPORT_BLOCKED
    COMPLETE
}

scalar Date
scalar Void