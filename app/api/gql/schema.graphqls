schema {
	query: Query
	mutation: Mutation
}

type Query {
	"the current logged in user. If not logged in, show default public viewer"
	me: User!
	task(id: ID!): Task!
}

type Mutation {
	# Tasks
	createTask(task: TaskInput!): Task!
	deleteTask(taskId: ID!): Boolean!
	updateTask(taskId: ID!, task: TaskInput!): Task!
	startTask(taskId: ID!): Boolean!
	completeTask(taskId: ID!): Boolean!
	# Comments
	comment(taskID: ID!, content: String!): Comment!
	# Teams
	updateActiveTeam(teamId: ID!): Boolean!
}

input TaskInput {
	goal: String
	dueAt: Time
	context: String
	ownerUserId: ID
}

interface Entity {
	id: ID!
	createdAt: Time!
}

type Team implements Entity {
	id: ID!
	name: String!
	logoUrl: String
	createdAt: Time!
	members: [User!]!
	tasks(input: TaskFilter): [Task!]!
}

type PersonalStatus {
	taskNeedAttention: Task
	upcomingTasks: [Task!]!
	deliveredTasks: [Task!]!
}

type TeamStatus {
	upcomingTasks: [Task!]!
	inProgressTasks: [Task!]!
	deliveredTasks: [Task!]!
}

type Option {
	value: Int!
	label: String!
}

type Task implements Entity {
	id: ID!
	goal: String!
	context: String!
	creator: User!
	owner: User
	status: TaskStatus!
	comments: [Comment!]!
	# Relationships with other entities
	mentions: [Mention!]!
	# Time Flow
	createdAt: Time!
	dueAt: Time
	lifetimeEvents: [LifetimeEvent!]!
}

type Comment {
	id: ID!
	content: String!
	commenter: User!
	task: Task!
	# mentions: [Mention!]!
}

type User implements Entity {
	id: ID!
	lastName: String!
	firstName: String!
	profileUrl: String!
	createdAt: Time!
	activeTeam: Team
	teams: [Team!]!
	"If input is null, return all related tasks"
	tasks(input: TaskFilter): [Task!]!
}

input TaskFilter {
	id: ID
	"a string filter that searches in both goal and context. Not Implemented."
	text: String
	status: TaskStatus
}

enum TaskAction {
	START
	DELETE
	ASSIGN_OWNER
	REPORT_BLOCKED
	MARK_COMPLETE
}

enum TaskStatus {
	UPCOMING
	IN_PROGRESS
	DELIVERED
}

scalar Time

"""
LifetimeEvent
"""
type LifetimeEvent {
    id: ID!
	# todo: will add eventType & actor when v1 is merged with v2
    # eventType: LifetimeEventType!
    "who did it"
    # actor:     User!
	actorID:   ID!
    happensAt: Time!
}

"""
Mention is a backend computed value according to text content of task or comments
so that frontend doesn't need to compute is again.
"""
type Mention {
	# todo: will add when v2 User & Task is merged into v1
	# mentionable: Mentionable!
	"""
	offset is the 0-based index of the starting of the mentioned text.
	The frontend can use this information to heightlight/replace/hyperlink the substring
	"""
	offset: Int!
	"the length of the mentioned text"
	limit: Int!
}

union Mentionable = User | Task

