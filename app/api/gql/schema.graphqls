schema {
	query: Query
	mutation: Mutation
}

type Query {
	"the current logged in user. If not logged in, show default public viewer"
	me: User!
	task(id: ID!): Task!
	executionMode: ExecutionMode! @deprecated(reason: "during refactor")
}

type Mutation {
	createTask(task: TaskInput!): Task!
	deleteTask(taskId: ID!): Boolean!
	updateTask(taskId: ID!, task: TaskInput!): Boolean!
	startTask(taskId: ID!): Boolean!
	completeTask(taskId: ID!): Boolean!
	updateActiveTeam(teamId: ID!): Boolean!
}

input TaskInput {
	goal: String
	dueAt: Time
	context: String
	ownerUserId: ID
	workScopeIndex: Int
	dependsOnTaskIds: [ID!]
	numOfUnknowns: Int
}

interface Entity {
	id: ID!
	createdAt: Time!
}

type Team implements Entity {
	id: ID!
	name: String!
	logoUrl: String
	createdAt: Time!
	members: [User!]!
}

type ExecutionMode {
	personalStatus: PersonalStatus!
	teamStatus: TeamStatus!
}

type PersonalStatus {
	taskNeedAttention: Task
	upcomingTasks: [Task!]!
	deliveredTasks: [Task!]!
}

type TeamStatus {
	upcomingTasks: [Task!]!
	inProgressTasks: [Task!]!
	deliveredTasks: [Task!]!
}

type Option {
	value: Int!
	label: String!
}

type Task implements Entity {
	id: ID!
	goal: String!
	dueAt: Time
	context: String
	owner: User
	creator: User!
	workScope: Option!
	effort: Int
	dependsOn: [Task!]!
	numOfUnknowns: Int
	availableActions: [TaskAction!]!
	availableWorkScopes: [Option!]!
	createdAt: Time!
	updatedAt: Time
	lifetimeEvents: [LifetimeEvent!]!
	mentions: [Mention!]!
}

type User implements Entity {
	id: ID!
	lastName: String!
	firstName: String!
	profileUrl: String!
	createdAt: Time!
	activeTeam: Team
	teams: [Team!]!
}

enum TaskAction {
	START
	DELETE
	ASSIGN_OWNER
	REPORT_BLOCKED
	MARK_COMPLETE
}

scalar Time

"""
LifetimeEvent
"""
type LifetimeEvent {
    id: ID!
	# todo: will add eventType & actor when v1 is merged with v2
    # eventType: LifetimeEventType!
    "who did it"
    # actor:     User!
	actorID:   ID!
    happensAt: Time!
}

"""
Mention is a backend computed value according to text content of task or comments
so that frontend doesn't need to compute is again.
"""
type Mention {
	# todo: will add when v2 User & Task is merged into v1
	# mentionable: Mentionable!
	"""
	offset is the 0-based index of the starting of the mentioned text.
	The frontend can use this information to heightlight/replace/hyperlink the substring
	"""
	offset: Int!
	"the length of the mentioned text"
	limit: Int!
}

union Mentionable = User | Task

