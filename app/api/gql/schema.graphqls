schema {
	query: Query
	mutation: Mutation
}

"""
Team
"""
type Team {
	id: ID!
	name: String!
	iconUrl: String!
	createdAt: Time!
	creator: User!
	"creator is the owner. In the future there will be features to transfer ownership to other users, just like GitHub repo."
	owner: User!
	"creator is the only admin for now"
	admins: [User!]!
	members: [User!]!
	tasks(input: TaskFilter): [Task!]!
	tasksNeedAttention(isMine: Boolean = false): [Task!]!
	invitations: [Invitation!]!
}

input CreateTeamInput {
	name: String!
}

input UpdateTeamInput {
	id: ID!
}

"""
Comment
"""
type Comment {
	id: ID!
	content: String!
	commenter: User!
	task: Task!
	createdAt: Time!
	# mentions: [Mention!]!
}

"""
User
"""
type User {
	id: ID!
	lastName: String!
	firstName: String!
	profileUrl: String!
	createdAt: Time!
	activeTeam: Team
	teams(ids: [ID!]): [Team!]!
	"""
	If input is null, return all related tasks.
	Ignore TaskFilter.creatorID
	"""
	tasks(input: TaskFilter): [Task!]!
}

input CreateUserInput {
	lastName: String!
	firstName: String!
	profileUrl: String
}

"""
Task
"""
type Task {
	id: ID!
	goal: String!
	context: String!
	creator: User!
	owner: User
	ownedByTeam: Team
	status: TaskStatus!
	comments: [Comment!]!
	# Relationships with other entities
	mentions: [Mention!]!
	# Time Flow
	createdAt: Time!
	dueAt: Time
	availableActions: [TaskAction!]!
	lifetimeEvents: [LifetimeEvent!]!
}

input TaskFilter {
	id: ID
	creatorId: ID
	ownerId: ID
	"a string filter that searches in both goal and context. Not Implemented."
	text: String
	status: TaskStatus
}

enum TaskAction {
	START
	DELETE
	ASSIGN_OWNER
	REPORT_BLOCKED
	MARK_COMPLETE
}

enum TaskStatus {
	UPCOMING
	IN_PROGRESS
	DELIVERED
}

input TaskInput {
	goal: String
	dueAt: Time
	context: String
	ownerUserId: ID
	status: TaskStatus
}

"""
Invitation
"""
type Invitation {
	id: ID!
	sender: User!
	receiverFirstName: String!
	receiverLastName: String!
	receiver: User
	team: Team!
	expireAt: Time!
	createdAt: Time!
	status: InvitationStatus!
	code: String!
}

enum InvitationStatus {
	PENDING
	ACCEPTED
	REVOKED
	DECLINED
	EXPIRED
}

input CreateInvitationInput {
	teamId: ID!
	receiverFirstName: String!
	receiverLastName: String!
	expireAt: Time!
}

input UpdateInvitationInput {
	senderUserId: ID
	receiverUserId: ID
	teamId: ID
	expireAt: Time
	status: InvitationStatus
}

input InvitationFilter {
	id: ID
	code: String
}

"""
LifetimeEvent
"""
type LifetimeEvent {
	id: ID!
	# todo: will add eventType & actor when v1 is merged with v2
	# eventType: LifetimeEventType!
	"who did it"
	# actor:     User!
	actorID:   ID!
	happensAt: Time!
}

"""
Mention

Mention is a backend computed value according to text content of task or comments
so that frontend doesn't need to compute is again.
"""
type Mention {
	# todo: will add when v2 User & Task is merged into v1
	# mentionable: Mentionable!
	"""
	offset is the 0-based index of the starting of the mentioned text.
	The frontend can use this information to heightlight/replace/hyperlink the substring
	"""
	offset: Int!
	"the length of the mentioned text"
	limit: Int!
}

union Mentionable = User | Task

scalar Time

type Query {
	"the current logged in user. If not logged in, show default public viewer"
	me: User!
	task(id: ID!): Task!
	"return all tasks for debug purpose"
	tasks(input: TaskFilter): [Task!]!
	teams(ids: [ID!]): [Team!]!
	invitations(input: InvitationFilter!): [Invitation!]!
}

type TaskMutation {
	createTask(task: CreateTaskInput!): TaskMutation!
	updateTask(taskId: ID!, task: TaskInput!): TaskMutation!
	deleteTask(taskId: ID!): TaskMutation!
	"change ownedByTeam of task field to id"
	updateOwningTeam(id: ID!): TaskMutation!
	"TODO: replace with unset API"
	removeOwner: TaskMutation!

	task: Task!
	mutation: Mutation!
}

type CommentMutation {
	createComment(taskId: ID!, content: String!): CommentMutation!
	updateContent(content: String!): CommentMutation!
	deleteComment: CommentMutation!

	comment: Comment!
	mutation: Mutation!
}

type TeamMutation {
	createTeam(input: CreateTeamInput!): TeamMutation!
	updateTeam(teamId: ID!, input: UpdateTeamInput!): TeamMutation!

	"Given the user id, add the user to the team."
	addMember(memberId: ID!): TeamMutation!
	removeMember(memberId: ID!): TeamMutation!

	"Remove the task from the team"
	removeTask(taskId: ID!): TeamMutation!
	"Given the task id, promote an In Progress task to Need Attention."
	promoteTaskToNeedAttention(taskId: ID!): TeamMutation!

	team: Team!
	mutation: Mutation!
}

type UserMutation {
	createUser(input: CreateUserInput!): UserMutation!
	updateActiveTeam(userId: ID!, teamId: ID!): UserMutation!
	updateUser(userId: ID!, input: UpdateUserInput!): UserMutation!

	user: User!
	mutation: Mutation!
}

type InvitationMutation {
	createInvitation(input: CreateInvitationInput!): InvitationMutation!
	acceptInvitation(code: String): InvitationMutation!
	acceptInvitation(code: String): InvitationMutation!
	updateInvitation(invitationId: ID!, input: UpdateInvitationInput!): InvitationMutation!
	deleteInvitation(invitationId: ID!): InvitationMutation!

	invitation: Invitation!
	mutation: Mutation!
}

"""
Mutation
"""
type Mutation {
	"""
	Task
	A task can exist independently from a team
	"""
	taskMutation: TaskMutation!
	commentMutation: CommentMutation!
	teamMutation: TeamMutation!
	userMutation: UserMutation!
	invitationMutation: InvitationMutation!
}

input CreateTaskInput {
	goal: String
	context: String
	dueAt: Time
	ownerUserId: ID
	status: TaskStatus
}

input UpdateUserInput {
	lastName: String
	firstName: String
	profileUrl: String
}

input TeamUpdateInput {
	name:       String
	iconUrl: String
}

