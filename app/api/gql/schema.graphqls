schema {
	query: Query
	mutation: Mutation
}

type Query {
	"the current logged in user. If not logged in, show default public viewer"
	me: User!
	task(id: ID!): Task!
	"return all tasks for debug purpose"
	tasks(input: TaskFilter): [Task!]!
	# Teams
	"""
	get all teams
	Admin && Debug Only resolvers
	"""
	teams: [Team!]!
}

type Mutation {
	# Tasks
	createTask(task: TaskInput!): Task!
	updateTask(taskId: ID!, task: TaskInput!): Task!
	deleteTask(taskId: ID!): Task!
	# startTask(taskId: ID!): Boolean!
	# completeTask(taskId: ID!): Boolean!
	# Comments
	comment(taskID: ID!, content: String!): Comment!
	# Teams
	createTeam(input: TeamInput!): Team!

	# Users
	updateActiveTeam(teamId: ID!): User!

	# todo: implement a directive that hide this resolver from production
	# or when the logged in user is not a system admin
	"Admin && Debug Only resolvers"
	createUser(input: UserInput!): User!
	updateUser(input: UserInput!): User!
}



interface Entity {
	id: ID!
	createdAt: Time!
}



########
# Team #
########
type Team implements Entity {
	id: ID!
	name: String!
	logoUrl: String
	createdAt: Time!
	creator: User!
	"creator is the owner. In the future there will be features to transfer ownership to other users, just like GitHub repo."
	owner: User!
	"creator is the only admin for now"
	admins: [User!]!
	members: [User!]!
	tasks(input: TaskFilter): [Task!]!
}

input TeamInput {
	name: String!
}


###########
# Comment #
###########
type Comment {
	id: ID!
	content: String!
	commenter: User!
	task: Task!
	# mentions: [Mention!]!
}

########
# User #
########
type User implements Entity {
	id: ID!
	lastName: String!
	firstName: String!
	profileUrl: String!
	createdAt: Time!
	activeTeam: Team
	teams: [Team!]!
	"""
	If input is null, return all related tasks.
	Ignore TaskFilter.creatorID
	"""
	tasks(input: TaskFilter): [Task!]!
}

input UserInput {
	id: ID
	lastName: String
	firstName: String
}

########
# Task #
########
type Task implements Entity {
	id: ID!
	goal: String!
	context: String!
	creator: User!
	owner: User
	status: TaskStatus!
	comments: [Comment!]!
	# Relationships with other entities
	mentions: [Mention!]!
	# Time Flow
	createdAt: Time!
	dueAt: Time
	availableActions: [TaskAction!]!
	lifetimeEvents: [LifetimeEvent!]!
}

input TaskFilter {
	id: ID
	creatorID: ID
	"a string filter that searches in both goal and context. Not Implemented."
	text: String
	status: TaskStatus
}

enum TaskAction {
	START
	DELETE
	ASSIGN_OWNER
	REPORT_BLOCKED
	MARK_COMPLETE
}

enum TaskStatus {
	UPCOMING
	IN_PROGRESS
	DELIVERED
}

input TaskInput {
	goal: String
	dueAt: Time
	context: String
	ownerUserId: ID
	status: TaskStatus
}


"""
LifetimeEvent
"""
type LifetimeEvent {
    id: ID!
	# todo: will add eventType & actor when v1 is merged with v2
    # eventType: LifetimeEventType!
    "who did it"
    # actor:     User!
	actorID:   ID!
    happensAt: Time!
}

"""
Mention is a backend computed value according to text content of task or comments
so that frontend doesn't need to compute is again.
"""
type Mention {
	# todo: will add when v2 User & Task is merged into v1
	# mentionable: Mentionable!
	"""
	offset is the 0-based index of the starting of the mentioned text.
	The frontend can use this information to heightlight/replace/hyperlink the substring
	"""
	offset: Int!
	"the length of the mentioned text"
	limit: Int!
}

union Mentionable = User | Task

scalar Time